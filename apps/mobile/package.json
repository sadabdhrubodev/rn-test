{
  "name": "helloworldapp",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "prebuild:android": "expo prebuild --platform android --clean",
    "clean": "[ -d android ] && ./gradlew clean --project-dir android --no-daemon; rm -rf .expo android ios dist",
    "build:apk": "bun run prebuild:android && cd android && chmod +x gradlew && ./gradlew assembleDebug --no-daemon",
    "build:apk:release": "bun run prebuild:android && cd android && chmod +x gradlew && ./gradlew assembleRelease --no-daemon",
    "build:apk:fast": "[ -d android ] || bun run prebuild:android; cd android && chmod +x gradlew && ./gradlew assembleRelease",
    "build": "bun run build:apk:release",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "catalog:",
    "@react-navigation/drawer": "catalog:",
    "expo": "catalog:",
    "expo-application": "catalog:",
    "expo-asset": "catalog:",
    "expo-constants": "catalog:",
    "expo-file-system": "catalog:",
    "expo-font": "catalog:",
    "expo-intent-launcher": "catalog:",
    "expo-linking": "catalog:",
    "expo-notifications": "catalog:",
    "expo-router": "catalog:",
    "expo-splash-screen": "catalog:",
    "expo-status-bar": "catalog:",
    "query-string": "catalog:",
    "react": "catalog:",
    "react-native": "catalog:",
    "react-native-edge-to-edge": "catalog:",
    "react-native-gesture-handler": "catalog:",
    "react-native-reanimated": "catalog:",
    "react-native-safe-area-context": "catalog:",
    "react-native-screens": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:"
  },
  "private": true
}
