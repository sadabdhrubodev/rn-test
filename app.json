{
  "expo": {
    "name": "helowrldApp",
    "slug": "helowrldApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "helowrldApp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.example.helowrldApp",
      "versionCode": 1,
      "permissions": [
        "REQUEST_INSTALL_PACKAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "react-native-edge-to-edge",
      "./plugins/withArm64Only",
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
