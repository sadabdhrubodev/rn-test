{
  "expo": {
    "name": "HelloWorldAppAppAppApp",
    "slug": "helloworldappappappapp",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "helloworldappappappapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.example.helloworldappappappapp"
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
